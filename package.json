{
  "name": "typescript-to-rust",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ttr": "bun run packages/compiler/index.ts",
    "bench": "bun run benchmarks/harness/bench.ts",
    "bench:verify": "bun run benchmarks/harness/verify.ts",
    "test": "bun test packages/compiler",
    "test:changed": "bun run packages/compiler/scripts/test-changed.ts",
    "typecheck": "tsc -p packages/compiler/tsconfig.json --noEmit && tsc -p benchmarks/tsconfig.json --noEmit",
    "rust:check": "cargo check",
    "rust:test": "cargo test",
    "check": "bun run typecheck && bun run rust:test && bun run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lower:snapshot": "bun run packages/compiler/scripts/lower-snapshot.ts snapshot",
    "lower:verify": "bun run packages/compiler/scripts/lower-snapshot.ts verify"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@ttr/plugin-leftpad": "workspace:*",
    "@ttr/std": "workspace:*",
    "@types/bun": "^1.3.14",
    "mitata": "^1.0.34",
    "typescript": "^5.5.2"
  }
}
